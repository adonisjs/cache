{
  "name": "@adonisjs/cache",
  "description": "Official caching module for AdonisJS framework",
  "version": "2.1.0",
  "engines": {
    "node": ">=22.0.0"
  },
  "main": "build/index.js",
  "type": "module",
  "files": [
    "build",
    "!build/bin",
    "!build/tests"
  ],
  "exports": {
    ".": "./build/index.js",
    "./types": "./build/src/types.js",
    "./commands/*": "./build/commands/*.js",
    "./commands": "./build/commands/main.js",
    "./services/main": "./build/services/main.js",
    "./cache_provider": "./build/providers/cache_provider.js"
  },
  "scripts": {
    "clean": "del-cli build",
    "copy:templates": "copyfiles --up 1 \"stubs/**/*.stub\" build",
    "typecheck": "tsc --noEmit",
    "index:commands": "adonis-kit index build/commands",
    "lint": "eslint",
    "format": "prettier --write .",
    "quick:test": "node --import=@poppinss/ts-exec --enable-source-maps bin/test.ts",
    "pretest": "npm run lint",
    "test": "c8 npm run quick:test",
    "prebuild": "npm run lint && npm run clean",
    "build": "tsdown && tsc --emitDeclarationOnly --declaration",
    "postbuild": "npm run copy:templates && npm run index:commands",
    "release": "npx release-it",
    "version": "npm run build",
    "prepublishOnly": "npm run build"
  },
  "devDependencies": {
    "@adonisjs/assembler": "^8.4.0",
    "@adonisjs/core": "^7.3.0",
    "@adonisjs/eslint-config": "^3.0.0",
    "@adonisjs/lucid": "^22.4.2",
    "@adonisjs/prettier-config": "^1.4.5",
    "@adonisjs/redis": "^10.0.0",
    "@adonisjs/tsconfig": "^2.0.0",
    "@japa/assert": "^4.2.0",
    "@japa/expect-type": "^2.0.4",
    "@japa/file-system": "^3.0.0",
    "@japa/runner": "^5.3.0",
    "@japa/snapshot": "^2.0.10",
    "@poppinss/ts-exec": "^1.4.4",
    "@release-it/conventional-changelog": "^10.0.6",
    "@types/node": "~25.5.2",
    "better-sqlite3": "^12.8.0",
    "c8": "^11.0.0",
    "copyfiles": "^2.4.1",
    "del-cli": "^7.0.0",
    "edge.js": "^6.5.0",
    "eslint": "^9.39.4",
    "ioredis": "^5.10.1",
    "knex": "^3.2.9",
    "luxon": "^3.7.2",
    "mysql2": "^3.20.0",
    "p-event": "^7.1.0",
    "pg": "^8.20.0",
    "prettier": "^3.8.1",
    "release-it": "^19.2.4",
    "tsdown": "^0.21.7",
    "typescript": "~6.0.2"
  },
  "dependencies": {
    "bentocache": "^1.6.1"
  },
  "peerDependencies": {
    "@adonisjs/assembler": "^8.0.0-next.19",
    "@adonisjs/core": "^7.0.0-next.13",
    "@adonisjs/lucid": "^22.0.0-next.1",
    "@adonisjs/redis": "^10.0.0-next.1"
  },
  "peerDependenciesMeta": {
    "@adonisjs/redis": {
      "optional": true
    },
    "@adonisjs/lucid": {
      "optional": true
    }
  },
  "author": "Julien Ripouteau <julien@ripouteau.com>",
  "contributors": [
    "Romain Lanz <romain.lanz@pm.me>"
  ],
  "license": "MIT",
  "keywords": [
    "adonisjs",
    "cache",
    "caching",
    "bentocache"
  ],
  "homepage": "https://github.com/adonisjs/cache#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/adonisjs/cache.git"
  },
  "bugs": {
    "url": "https://github.com/adonisjs/cache/issues"
  },
  "publishConfig": {
    "provenance": true,
    "access": "public"
  },
  "prettier": "@adonisjs/prettier-config",
  "release-it": {
    "git": {
      "requireCleanWorkingDir": true,
      "requireUpstream": true,
      "commitMessage": "chore(release): ${version}",
      "tagAnnotation": "v${version}",
      "push": true,
      "tagName": "v${version}"
    },
    "github": {
      "release": true
    },
    "npm": {
      "publish": true,
      "skipChecks": true
    },
    "plugins": {
      "@release-it/conventional-changelog": {
        "preset": {
          "name": "angular"
        }
      }
    }
  },
  "c8": {
    "reporter": [
      "text",
      "html"
    ],
    "exclude": [
      "tests/**"
    ]
  },
  "tsdown": {
    "entry": [
      "index.ts",
      "src/types.ts",
      "providers/cache_provider.ts",
      "services/main.ts",
      "commands/cache_clear.ts",
      "commands/cache_delete.ts",
      "commands/cache_prune.ts"
    ],
    "outDir": "./build",
    "clean": true,
    "format": "esm",
    "minify": "dce-only",
    "fixedExtension": false,
    "dts": false,
    "treeshake": false,
    "sourcemaps": false,
    "target": "esnext",
    "external": [
      "edge.js"
    ]
  },
  "packageManager": "pnpm@10.33.0"
}
